syntax on
filetype plugin indent on

let mapleader = " "

" Plugin list
source ~/.vim/plugin/plug-list.vim

" Rest of config is organized under plugin/*.vim and after/plugin/*

" Load Base16 theme if generated by shell (tinted-theming/base16)
if filereadable(expand('~/.vimrc_background'))
  execute 'source' expand('~/.vimrc_background')
endif
